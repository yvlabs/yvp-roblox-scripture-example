--!strict
local H = require("./harness")
local Cache = require("../src/shared/Cache")

return function()
	H.describe("Cache", function()
		H.it("returns a stored value before expiry", function()
			local clock = H.fakeClock()
			local cache = Cache.new(10, clock.now)
			cache:set("k", "v", 60)
			clock.advance(59)
			H.expectEqual(cache:get("k"), "v")
		end)

		H.it("expires a value at its TTL", function()
			local clock = H.fakeClock()
			local cache = Cache.new(10, clock.now)
			cache:set("k", "v", 60)
			clock.advance(60)
			H.expectEqual(cache:get("k"), nil)
		end)

		H.it("counts hits and misses", function()
			local clock = H.fakeClock()
			local cache = Cache.new(10, clock.now)
			cache:set("k", "v", 60)
			cache:get("k")
			cache:get("absent")
			H.expectEqual(cache.hits, 1)
			H.expectEqual(cache.misses, 1)
		end)

		H.it("evicts the oldest entry at capacity", function()
			local clock = H.fakeClock()
			local cache = Cache.new(2, clock.now)
			cache:set("a", 1, 600)
			clock.advance(1)
			cache:set("b", 2, 600)
			clock.advance(1)
			cache:set("c", 3, 600)
			H.expectEqual(cache:count(), 2)
			H.expectEqual(cache:get("a"), nil, "oldest evicted")
			H.expectEqual(cache:get("c"), 3)
			H.expectEqual(cache.evictions, 1)
		end)

		H.it("overwrites without growing the count", function()
			local cache = Cache.new(5, H.fakeClock().now)
			cache:set("k", 1, 60)
			cache:set("k", 2, 60)
			H.expectEqual(cache:count(), 1)
			H.expectEqual(cache:get("k"), 2)
		end)

		H.it("decrements the count when an expired entry is read", function()
			local clock = H.fakeClock()
			local cache = Cache.new(5, clock.now)
			cache:set("k", 1, 10)
			clock.advance(11)
			cache:get("k")
			H.expectEqual(cache:count(), 0)
		end)
	end)
end
