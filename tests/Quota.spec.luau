--!strict
local H = require("./harness")
local Quota = require("../src/shared/Quota")

return function()
	H.describe("Quota", function()
		H.it("permits spending up to the limit", function()
			local quota = Quota.new(3, 3600, H.fakeClock().now)
			H.expectTrue(quota:tryConsume())
			H.expectTrue(quota:tryConsume())
			H.expectTrue(quota:tryConsume())
			H.expectEqual(quota:remaining(), 0)
		end)

		H.it("denies once the limit is reached", function()
			local quota = Quota.new(2, 3600, H.fakeClock().now)
			quota:tryConsume()
			quota:tryConsume()
			H.expectFalsy(quota:tryConsume(), "third request")
			H.expectEqual(quota.denied, 1)
		end)

		H.it("frees budget as the window rolls forward", function()
			local clock = H.fakeClock()
			local quota = Quota.new(2, 3600, clock.now)
			quota:tryConsume()
			quota:tryConsume()
			H.expectFalsy(quota:tryConsume())
			clock.advance(3601)
			H.expectEqual(quota:remaining(), 2)
			H.expectTrue(quota:tryConsume())
		end)

		H.it("reports seconds until budget frees", function()
			local clock = H.fakeClock()
			local quota = Quota.new(1, 3600, clock.now)
			quota:tryConsume()
			clock.advance(600)
			H.expectEqual(quota:retryAfter(), 3000)
		end)

		H.it("reports zero retry delay when budget is available", function()
			local quota = Quota.new(5, 3600, H.fakeClock().now)
			H.expectEqual(quota:retryAfter(), 0)
		end)
	end)
end
