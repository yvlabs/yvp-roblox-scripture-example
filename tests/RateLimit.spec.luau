--!strict
local H = require("./harness")
local RateLimit = require("../src/shared/RateLimit")

return function()
	H.describe("RateLimit", function()
		H.it("allows a burst then blocks", function()
			local limiter = RateLimit.new(3, 5, H.fakeClock().now)
			H.expectTrue(limiter:allow("p1"))
			H.expectTrue(limiter:allow("p1"))
			H.expectTrue(limiter:allow("p1"))
			H.expectFalsy(limiter:allow("p1"), "fourth request")
		end)

		H.it("refills over time", function()
			local clock = H.fakeClock()
			local limiter = RateLimit.new(2, 5, clock.now)
			limiter:allow("p1")
			limiter:allow("p1")
			H.expectFalsy(limiter:allow("p1"))
			clock.advance(5)
			H.expectTrue(limiter:allow("p1"), "after refill")
		end)

		H.it("never refills beyond the burst size", function()
			local clock = H.fakeClock()
			local limiter = RateLimit.new(2, 5, clock.now)
			limiter:allow("p1")
			clock.advance(500)
			H.expectTrue(limiter:allow("p1"))
			H.expectTrue(limiter:allow("p1"))
			H.expectFalsy(limiter:allow("p1"), "capped at burst")
		end)

		H.it("tracks players independently", function()
			local limiter = RateLimit.new(1, 5, H.fakeClock().now)
			H.expectTrue(limiter:allow("p1"))
			H.expectFalsy(limiter:allow("p1"))
			H.expectTrue(limiter:allow("p2"), "separate bucket")
		end)

		H.it("forgets a departed player", function()
			local limiter = RateLimit.new(1, 5, H.fakeClock().now)
			limiter:allow("p1")
			limiter:forget("p1")
			H.expectTrue(limiter:allow("p1"))
		end)
	end)
end
